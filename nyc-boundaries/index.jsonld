          "schema:value": 0.82
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "Representations",
          "schema:value": 5
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "Provenance cluster",
          "schema:value": "U.S. Census"
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "Independence disposition",
          "schema:value": "Not independent corroboration"
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "Represented year",
          "schema:value": 2018
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "geoBoundaries build date",
          "schema:value": {
            "@value": "2023-12-12",
            "@type": "xsd:date"
          }
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "Numeric area availability",
          "schema:value": "not-provided-in-reviewed-source-record"
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "Measurement semantics",
          "schema:value": "The reviewed ADM2 features supply generalized geometry but no numeric area field, and their geometry is Census-derived."
        },
        {
          "@type": "schema:PropertyValue",
          "schema:name": "Independent land-area comparison disposition",
          "schema:value": "excluded"
        }
      ]
    },
    {
