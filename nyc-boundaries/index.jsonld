    {
      "@id": "https://knoedg.nyc/nyc-boundaries/#geoboundaries-adm2",
      "@type": "schema:Claim",
      "schema:text": "Five geoBoundaries USA ADM2 features are reviewed mappings to NYC counties. They are generalized, shoreline-clipped derivatives of 2018 Census MAF/TIGER cartographic boundaries and remain in the Census provenance cluster.",
      "schema:citation": {
        "@id": "https://github.com/wmgeolab/geoBoundaries/raw/9469f09592ced973a3448cf66b6100b741b64c0d/releaseData/gbOpen/USA/ADM2/geoBoundaries-USA-ADM2.geojson"
      },
      "schema:additionalProperty": [
        {
          "@type": "schema:PropertyValue",
          "schema:name": "KEE lifecycle state",
          "schema:value": "Active"
        },
        {
          "@type": "schema:PropertyValue",
