          {
            "type": "section",
            "id": "rights",
            "heading": [
              {
                "type": "text",
                "text": "Rights"
              }
            ],
            "children": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "No open license was identified for the map, the city reports or the press reports cited on this page."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The map is reproduced here from a local copy verified against the governed checksum. No redistribution permission for the map was located or is claimed. New York City Tourism + Conventions is identified as the publisher; the original image address and an archived capture are linked above."
                  }
                ]
              }
            ]
          },
          {
            "type": "section",
            "id": "validation",
            "heading": [
              {
                "type": "text",
                "text": "Validation"
              }
            ],
            "children": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The structured representation contains eight claims corresponding to the eight governed records in this collection. Publication checks reconcile the roster in both directions, verify citations and governed confidence values, and reject missing required sections or unsupported private coordinates."
                  }
                ]
              }
            ]
          },
          {
            "type": "section",
            "id": "limitations",
            "heading": [
              {
                "type": "text",
                "text": "Limitations"
              }
            ],
            "children": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "This page describes this published map and the sources used to examine it. It is not a directory, ranking or definition of New York City’s immigrant neighborhoods."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "No amended version of the map was located in the sources checked. That does not establish that an amended version does not exist at another address."
                  }
                ]
              }
            ]
          },
          {
            "type": "section",
            "id": "history",
            "heading": [
              {
                "type": "text",
                "text": "Publication history"
              }
            ],
            "children": [
              {
                "type": "list",
                "items": [
                  [
                    {
                      "type": "text",
                      "text": "Sources retrieved and checksummed — "
                    },
                    {
                      "type": "time",
                      "pointer": "/semanticRepresentation/@graph/9/prov:generatedAtTime/@value",
                      "format": "datetime"
                    }
                  ],
                  [
                    {
                      "type": "text",
                      "text": "Documents compared and the criteria examined — "
