              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "OpenStreetMap has no separate catalog datasets the way a government open-data portal does — each administrative area is its own directly editable relation. This page governs ten specific relation versions, retrieved via the OSM API (version 0.6)."
                  }
                ]
              }
            ]
