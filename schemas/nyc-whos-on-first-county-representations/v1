{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoedg.nyc/schemas/nyc-whos-on-first-county-representations/v1",
  "title": "NYC Who's On First county identity and geometry fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "type", "fixtureType", "fixtureVersion", "id", "resource", "title", "crs", "publisher", "source", "rights", "selection", "comparisonDisposition", "features", "limitations"],
  "properties": {
    "$schema": {"const": "https://knoedg.nyc/schemas/nyc-whos-on-first-county-representations/v1"},
    "type": {"const": "FeatureCollection"},
    "fixtureType": {"const": "whos-on-first-county-representation"},
    "fixtureVersion": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"},
    "id": {"const": "https://knoedg.nyc/data/fixtures/nyc-whos-on-first-county-representations.geojson"},
    "resource": {"const": "https://knoedg.nyc/nyc-boundaries/"},
    "title": {"type": "string", "minLength": 1},
    "crs": {"type": "object", "additionalProperties": false, "required": ["type", "properties"], "properties": {"type": {"const": "name"}, "properties": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "urn:ogc:def:crs:OGC:1.3:CRS84"}}}}},
    "publisher": {"type": "object", "additionalProperties": false, "required": ["name", "url"], "properties": {"name": {"const": "Who's On First"}, "url": {"const": "https://whosonfirst.org/"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "immutableCommit", "commitTime", "capturedAt", "retainedGeometryCanonicalSha256", "derivation"], "properties": {
      "repository": {"const": "whosonfirst-data/whosonfirst-data-admin-us"},
      "immutableCommit": {"const": "c4e4f9b2233c4b29a6f7124278b635e270d0b87d"},
      "commitTime": {"const": "2026-03-16T19:40:15Z"},
      "capturedAt": {"type": "string", "format": "date-time"},
      "retainedGeometryCanonicalSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "derivation": {"type": "string", "minLength": 1}
    }},
    "rights": {"type": "object", "additionalProperties": false, "required": ["redistributionDecision", "structureLicense", "geometryLicense", "licenseUrl", "attribution", "changes"], "properties": {
      "redistributionDecision": {"const": "approved"},
      "structureLicense": {"const": "CC0 (Who's On First repository structure)"},
      "geometryLicense": {"const": "Creative Commons Attribution (Quattroshapes geometry, source US Census)"},
      "licenseUrl": {"type": "string", "format": "uri"},
      "attribution": {"const": "Who's On First / Quattroshapes (source: US Census)"},
      "changes": {"type": "string", "minLength": 1}
    }},
    "selection": {"type": "object", "additionalProperties": false, "required": ["rule", "countingGranularity", "featureCount", "geometryIncluded"], "properties": {"rule": {"type": "string", "minLength": 1}, "countingGranularity": {"const": "current Who's On First county record"}, "featureCount": {"const": 5}, "geometryIncluded": {"const": true}}},
    "comparisonDisposition": {"type": "object", "additionalProperties": false, "required": ["provenanceCluster", "independentEvidenceFamily", "numericAreaStatus", "reason"], "properties": {"provenanceCluster": {"const": "U.S. Census Bureau (via Quattroshapes)"}, "independentEvidenceFamily": {"const": false}, "numericAreaStatus": {"const": "shapely-derived-non-independent"}, "reason": {"type": "string", "minLength": 1}}},
    "features": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["type", "id", "properties", "geometry"], "properties": {
      "type": {"const": "Feature"}, "id": {"type": "string", "format": "uri"},
      "properties": {"type": "object", "additionalProperties": false, "required": ["boroughCode", "boroughName", "countyName", "wofId", "placetype", "censusGeoid", "hascId", "geometrySource", "quattroshapesSource", "geomAreaSquareM", "sourceLastModified", "governedAssertion", "lifecycle", "confidence"], "properties": {
        "boroughCode": {"type": "integer", "minimum": 1, "maximum": 5},
        "boroughName": {"type": "string", "minLength": 1},
        "countyName": {"type": "string", "minLength": 1},
        "wofId": {"type": "integer", "minimum": 1},
        "placetype": {"const": "county"},
        "censusGeoid": {"type": "string", "pattern": "^[0-9]{5}$"},
        "hascId": {"type": "string", "minLength": 1},
        "geometrySource": {"const": "quattroshapes"},
        "quattroshapesSource": {"const": "US Census"},
        "geomAreaSquareM": {"type": "number", "exclusiveMinimum": 0},
        "sourceLastModified": {"type": "string", "format": "date-time"},
        "governedAssertion": {"type": "string", "format": "uri"},
        "lifecycle": {"const": "Active"},
        "confidence": {"const": 0.95}
      }},
      "geometry": {"type": "object", "additionalProperties": false, "required": ["type", "coordinates"], "properties": {
        "type": {"enum": ["Polygon", "MultiPolygon"]},
        "coordinates": {"type": "array"}
      }}
    }}},
    "limitations": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  }
}
